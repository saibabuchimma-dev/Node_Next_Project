{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "types": [],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/controllers/userController.ts", "src/routes/userRoutes.ts", "src/server.ts"], 
  "exclude": ["node_modules"]
}